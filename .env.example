# ============================================================================
# AGRICONNECT Environment Configuration (.env)
# ============================================================================

# Flask App Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=agriconnect-secret-change-this-in-production
DATABASE_PATH=instance/agriconnect.db
PORT=5000

# Supabase PostgreSQL & Supabase Auth Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
